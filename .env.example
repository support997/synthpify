# Server-side Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL
# Copy this file to .env and populate with your production values

# Vapi AI Voice Agent Configuration (Keep server-side only)
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Automation & Chat Webhooks (Keep server-side only)
AUTOMATION_WEBHOOK_URL=https://your-n8n-platform.com/webhook/your-lead-webhook
N8N_CHAT_WEBHOOK_URL=https://your-n8n-platform.com/webhook/your-chat-webhook

# SMTP Mail Server Configuration (Optional for production email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=youremail@example.com
SMTP_PASS=your_app_password_here
MAIL_FROM=support@synthpify.ai
MAIL_TO=contact@synthpify.ai

# CORS & Server Settings
CORS_ORIGIN=http://localhost:5173,https://synthpify.ai,https://www.synthpify.ai
PORT=3001
